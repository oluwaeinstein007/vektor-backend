{
  "name": "@vektor/auth",
  "version": "0.1.0",
  "private": true,
  "description": "SEC-003: RBAC enforcement shared across every public-facing Fastify service — Keycloak-shaped JWT verification (§5.1 roles) plus a requireRole() preHandler. See VEKTOR-PRD.md §14.1/§14.3.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-tests/tests/*.test.js",
    "dev:auth-bridge": "tsc -p tsconfig.json && node dist/dev-auth-bridge.js",
    "clean": "rm -rf dist dist-tests"
  },
  "dependencies": {
    "fastify-plugin": "^5.1.0",
    "jose": "^5.10.0"
  },
  "peerDependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fastify": "^5.2.0",
    "typescript": "^5.7.2"
  }
}
