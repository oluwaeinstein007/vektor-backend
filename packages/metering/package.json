{
  "name": "@vektor/metering",
  "version": "0.1.0",
  "private": true,
  "description": "NW-016: usage metering. Records billable events (ingested sensor events, inference frames, COA generations, API calls, connected sensors) per organisation, emitted fire-and-forget onto Kafka and rolled up into a per-period table. Nothing counted on a request's critical path.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "test:coverage": "pnpm build && node --test --experimental-test-coverage --test-coverage-exclude='**/tests/**' --test-coverage-exclude='**/*.test.*' dist/tests/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vektor/db": "workspace:*",
    "@vektor/kafka": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "kafkajs": "^2.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
