{
  "name": "@vektor/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Re-exports @vektor/proto for every vektor-platform app and service. Never redeclares a schema — see VEKTOR-PRD.md §12.1.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vektor/proto": "link:../../../vektor-proto"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
