{
  "name": "@vektor/model-registry",
  "version": "0.1.0",
  "private": true,
  "description": "NW-021: joins cv-train-svc's training/export to cv-inference-svc's hot-swap endpoint. Tracks training jobs and model versions per organisation, enforces the job state machine, and promotes a version into a running inference deployment.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:coverage": "pnpm build && node --test --experimental-test-coverage --test-coverage-exclude='**/tests/**' --test-coverage-exclude='**/*.test.*' dist/tests/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vektor/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.24.1"
  },
  "devDependencies": { "@types/node": "^22.10.2", "typescript": "^5.7.2" }
}
