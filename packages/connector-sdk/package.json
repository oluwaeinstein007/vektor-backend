{
  "name": "@vektor/connector-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "NW-019: the documented adapter interface third-party sensor connectors are written against, plus reference implementations. Factors out the envelope, timestamp validation, schema enforcement, Kafka publication, reconnection and health accounting that every hand-written ingest-svc adapter currently repeats.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "test:coverage": "pnpm build && node --test --experimental-test-coverage --test-coverage-exclude='**/tests/**' --test-coverage-exclude='**/*.test.*' dist/tests/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vektor/kafka": "workspace:*",
    "@vektor/shared": "workspace:*",
    "kafkajs": "^2.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
