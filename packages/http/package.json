{
  "name": "@vektor/http",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Fastify HTTP conventions: the common error-response schema and a default error handler, so every service's expected and unexpected errors share one wire shape.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fastify-plugin": "^5.1.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fastify": "^5.2.0",
    "typescript": "^5.7.2"
  }
}
