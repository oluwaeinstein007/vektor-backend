{
  "name": "vektor-backend",
  "private": true,
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "description": "All TypeScript microservices and shared backend packages for VEKTOR. The frontend lives in the sibling vektor-web repo. See ../vektor-docs/VEKTOR-PRD.md §9.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "stack:up": "./scripts/dev-stack.sh up",
    "stack:up:full": "./scripts/dev-stack.sh up --full",
    "stack:down": "./scripts/dev-stack.sh down",
    "stack:status": "./scripts/dev-stack.sh status",
    "stack:token": "./scripts/dev-stack.sh token",
    "db:migrate": "pnpm --filter @vektor/db exec drizzle-kit migrate",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp",
      "node-llama-cpp",
      "protobufjs",
      "better-sqlite3"
    ],
    "overrides": {
      "protobufjs": ">=7.6.1 <8",
      "simple-git": ">=4.0.1 <5",
      "@simple-git/argv-parser": ">=2.0.1 <3",
      "@fastify/static": ">=10.1.3 <11",
      "adm-zip": ">=0.6.1 <0.7",
      "basic-ftp": ">=6.2.1 <7",
      "brace-expansion": ">=5.0.10 <6",
      "engine.io": ">=6.6.10 <7",
      "fast-uri": ">=4.1.4 <5",
      "image-size": ">=2.0.3 <3",
      "js-yaml": ">=4.3.2 <5",
      "sharp": ">=0.35.5 <0.36",
      "undici": ">=7.29.1 <8"
    }
  }
}
