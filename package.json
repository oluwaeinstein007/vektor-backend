{
  "name": "vektor-backend",
  "private": true,
  "version": "0.1.0",
  "description": "All TypeScript microservices and shared backend packages for VEKTOR. The frontend lives in the sibling vektor-web repo. See ../vektor-docs/VEKTOR-PRD.md §9.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp",
      "node-llama-cpp",
      "protobufjs",
      "better-sqlite3"
    ]
  }
}
