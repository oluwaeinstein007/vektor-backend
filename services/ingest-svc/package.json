{
  "name": "@vektor/ingest-svc",
  "version": "0.1.0",
  "private": true,
  "description": "SVC-001: fluent-ffmpeg RTSP/SRT -> kafkajs producer (REQ-1.1). Extracts raw video frames from a live FMV source and publishes them to Kafka with sensor_ts-validated metadata.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "start": "node dist/src/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vektor/kafka": "workspace:*",
    "@vektor/shared": "workspace:*",
    "fluent-ffmpeg": "^2.1.3",
    "kafkajs": "^2.2.4",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
