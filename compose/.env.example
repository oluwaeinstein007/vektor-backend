# NW-003: copy to the repo root as `.env` (`cp compose/.env.example .env`) and
# source it before `pnpm dev`, or paste the lines you need in front of a single
# service's start command. Every value matches compose/docker-compose.dev.yml's
# published host ports — see compose/README.md for why those ports and not the
# ones in each service's README.

# ---- core infra ----
DATABASE_URL=postgres://postgres:vektor@localhost:15432/vektor
KAFKA_BROKERS=localhost:19092
REDIS_URL=redis://localhost:16379
VEKTOR_ENV=dev

# ---- auth (every RBAC-gated service refuses to start without this) ----
KEYCLOAK_JWKS_URI=http://localhost:18080/realms/vektor/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:18080/realms/vektor
# KEYCLOAK_AUDIENCE is left unset on purpose: Keycloak puts the client id in
# `azp`, not `aud`, for a public client's access token, so setting it here
# would reject every token the dev realm issues.

# ---- email (alert-svc, reporting-svc) ----
SMTP_URL=smtp://localhost:11025
SMTP_FROM=alerts@vektor.test

# ---- ingest-svc: pick at least one adapter or it exits by design ----
INGEST_SOURCE_URL=rtsp://localhost:8554/testcam
RTSP_SENSOR_ID=dev-cam-1
RTSP_TRANSPORT=tcp
MQTT_BROKER_URL=mqtt://localhost:11883
MQTT_TOPIC_FILTER=vektor/sensors/#
MQTT_SENSOR_ID=dev-iot-1
FIELD_DEVICE_SHARED_SECRET=dev-device-secret
FIELD_INGEST_PORT=3016

# ---- `--profile full` only ----
QDRANT_URL=http://localhost:16333
ROUTING_DATABASE_URL=postgres://postgres:vektor@localhost:15434/vektor_routing
ERP_DATABASE_URL=postgres://postgres:vektor@localhost:15433/erp
# coa-svc: `cloud` needs vektor-ml's llm-cloud-svc over gRPC; `edge` needs a
# local GGUF (see services/coa-svc/tests/fixtures/README.md and NW-007).
VEKTOR_COA_MODE=cloud
LLM_CLOUD_SVC_ADDRESS=localhost:50051

# ---- reporting-svc: system Chrome, never a bundled download ----
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
